<misterromdescription>
    <name>Raiden Fighters (Japan, earliest)</name>
    <setname>rdftja</setname>
    <rbf>SeibuSPI</rbf>
    <mameversion>0277</mameversion>
    <year>1996</year>
    <manufacturer>Seibu Kaihatsu</manufacturer>
    <players>2</players>
    <joystick>8</joystick>
    <rotation>vertical (cw)</rotation>
    <region>Japan</region>
    <category>Shooter</category>

    <!--
      GENERATED by tools/gen_mras.py from MAME's ROM_START(rdftja).
      Edit the generator, not this file.

      A clone of rdft, part for part: the same ROM layout, the same
      decryption (MAME's init_rdft against the parent's init_rdft), and a
      program of its own -- which is why the job table below is not the
      parent's address.

      make check-mra holds every part here against MAME's ROM_START and
      against rom_loader.sv's table.  make check-clones re-derives the job
      table from the ROMs and checks that the flash it builds is rdft's
      payload byte for byte.

      Region 0x01 = Japan.  The same byte is in the program image at
      0x1ffffc and in the blank flash's byte 0; the mainboard refuses a
      cartridge from another region.

      Part order is significant: rom_loader.sv walks this list with a fixed
      table selected by the mod byte, and infers each part's destination and
      byte scatter from its INDEX, not from anything in this file.
    -->

    <!--
      Index 1, the core's config blob, and it MUST precede the index-0 image:
      Main_MiSTer sends <rom> elements in file order and the loader has to know
      its table before the bytes start.

        byte 0     mod byte 0x11 -- cartridge board, set 0, authentic-flash tail
        1..15      {part, codec} pairs; FF terminates, nothing here is decoded
        16..19     job table  0x002017a5
        20..23     stamp      0x003ffffc
        24         generation 1

      The sample flash itself is an OSD option, "Sample Flash": Pre-built (the
      default) has the core build the image out of SDRAM in about a third of a
      second, Ritual has the game program its own flash over about six minutes.
    -->
    <rom index="1">
      <part>11</part>
      <part>FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF</part>
      <part>A5 17 20 00</part>
      <part>FC FF 3F 00</part>
      <part>01</part>
    </rom>

    <!--
      Parts resolve by CRC first (Main_MiSTer's zip_search_by_crc), so a
      merged set works even though most of these files are stored under the
      parent's directory or name.  The CRCs are load-bearing.
    -->
    <rom index="0" address="0x30000000" zip="rdftja.zip|rdft.zip" md5="none">
        <!-- maincpu: 386 program -->
        <part name="rf1.bin"                     crc="46861b75"/>
        <part name="rf2.bin"                     crc="6388ed11"/>
        <part name="rf3.bin"                     crc="beafcd24"/>
        <part name="rf4.bin"                     crc="5236f45f"/>
        <!-- chars: text layer -->
        <part name="seibu_5.u0423"               crc="8f8d4e14"/>
        <part name="seibu_6.u0424"               crc="6ac64968"/>
        <part name="seibu_7.u048"                crc="4d87e1ea"/>
        <!-- tiles: background tiles -->
        <part name="gun_dogs_bg1-d.u0415"        crc="6a68054c"/>
        <part name="gun_dogs_bg1-p.u0410"        crc="3400794a"/>
        <part name="gun_dogs_bg2-d.u0424"        crc="61cd2991"/>
        <part name="gun_dogs_bg2-p.u049"         crc="502d5799"/>
        <!-- sprites: three plane-pair chunks, interleaved by the loader -->
        <part name="gun_dogs_obj-1.u0322"        crc="59d86c99"/>
        <part name="gun_dogs_obj-2.u0324"        crc="1ceb0b6f"/>
        <part name="gun_dogs_obj-3.u0323"        crc="36e93234"/>
        <!-- sound01: the ROMs the updater reads, carried whole -->
        <part name="gun_dogs_pcm.u0217"          crc="31253ad7"/>
        <part name="seibu_8.u0216"               crc="f88cb6e4"/>
        <!-- soundflash1: the sample flash, BLANK -- byte 0 is the region lock -->
        <part name="flash0_blank_region01.u1053" crc="7ae7ab76"/>
        <!-- the second E28F008SA, erased -- MAME has no dump for it -->
        <part repeat="0x100000">FF</part>
    </rom>

    <!--
      The save file, in /media/fat/config/nvram/.  ONE element, because an MRA
      gets one: everything the board remembers is concatenated into it.

        0x000000..0x1FFFFF   the two E28F008SA sample flash chips
        0x200000..0x2001FF   the DS2404's 512 bytes of bookkeeping SRAM

      2,097,664 bytes.  The tail is byte-for-byte MAME's own `ds2404` file, so
      a save can be assembled from MAME's soundflash1, soundflash2 and ds2404
      in that order.  In Pre-built mode the flash half is written but not read
      back -- the image is derived every boot -- and the DS2404 half is live
      either way, which is what makes the bookkeeping persist at all.

      It must stay below the <rom> element: Main_MiSTer sends it after the
      index-0 image, which is what lets it land on the blank flash.
    -->
    <nvram index="2" size="2097664"/>

    <buttons names="Shot,Bomb,Button 3,Start,Coin,Service Coin,Test"
             default="A,B,X,Start,Select,R,L" count="3"/>

    <switches default="00" base="0">
        <dip name="Flip Screen"  bits="0" ids="Off,On"/>
        <dip name="Service Mode" bits="1" ids="Off,On"/>
    </switches>
</misterromdescription>
