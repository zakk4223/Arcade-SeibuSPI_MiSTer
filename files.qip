# stay in the tree for the next investigation; nothing instantiates them, so
# nothing of theirs reaches the fabric. PLAN.md 29.

# Sound: Z80 + YMF271. The T80 core is VHDL, so it comes in through its own qip.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_sound.sv
