# Save states. system_consts.sv must come first: it is the package the rest
# import. savestates.sv declares the ssbus_if interface every slave takes as a
# port, so it has to precede them too.
#
# The first four are vendored from Arcade-IGSPGM_MiSTer and kept close to
# upstream so they can be diffed against it; savestate_ui.sv is Robert Peip's,
# via the same route. rtl/spi_ss*.sv are ours. PLAN.md 38 and 39.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/system_consts.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/savestates.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/memory_stream.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ddram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ss_ram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/savestate_ui.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_ss.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_ss_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_ss_vram.sv

# NOT BUILT, deliberately: rtl/spi_romcheck.sv, the checksum walker. Nothing
# instantiates it, so nothing of it reaches the fabric -- and it is not listed
# here, which is what this note exists to explain. It stays in the tree because
# `make -C sim run-romcheck` builds it as its own top module. The three that used
# to be named alongside it -- the vital signs panel, the ISSP probes and the bus
# meter -- were deleted in PLAN.md 35, and were never listed here either.
# PLAN.md 29.

# Sound: Z80 + YMF271.
#
# The Z80 is tv80, not T80, and only because of savestates: state_module.py
# reads Verilog and rtl/t80 is VHDL, so PGM's already-generated
# tv80_auto_ss.sv is what makes the Z80's state free. PLAN.md 40.
#
# rtl/tv80_auto_ss.sv REPLACES rtl/tv80/*.v -- same five module names -- so
# exactly one of the two is ever listed. rtl/t80 and rtl/tv80 both stay in the
# tree: the first as what this replaced, the second as what the generated file
# was generated from.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_sound.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ymf271.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ymf271_synth.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/tv80_auto_ss.sv

set_global_assignment -name SYSTEMVERILOG_FILE rtl/seibu_partial_add.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_tile_decrypt.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_spr_decrypt.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_rise10_decrypt.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/spi_rise11_decrypt.sv

# z386 CPU. z386_pkg.sv must be listed first: it declares the types the rest use.
set_global_assignment -name SEARCH_PATH rtl/z386
