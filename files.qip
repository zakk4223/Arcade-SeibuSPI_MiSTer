set_global_assignment -name SYSTEMVERILOG_FILE rtl/z386/alu_alt.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/z386/biu.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/z386/decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/z386/dsp_mul.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/z386/paging_tlb.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/z386/paging_unit.sv
