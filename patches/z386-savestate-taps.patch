# The savestate's read-only taps on z386, on top of the vendored core as it
# already stands in this tree (see z386-uncached-window.patch for the other
# local change). Three outputs, no logic altered: the board needs the IDT's
# base to overlay one interrupt gate, and CR0 to refuse a save taken before
# the game has entered protected mode.
#
# diff -u rtl/z386/z386.sv.orig rtl/z386/z386.sv
--- rtl/z386/z386.sv.orig	2026-08-20 00:49:47.692692011 -0400
+++ rtl/z386/z386.sv	2026-08-19 23:53:50.209660060 -0400
@@ -57,6 +57,12 @@
     output     [15:0]  dbg_CS,
     output     [31:0]  dbg_EIP,
     output     [31:0]  dbg_CS_base,
+    // -- SeibuSPI: the IDT's base and limit, so the board can overlay one
+    //    interrupt gate while a savestate is being taken. Read-only taps on
+    //    the descriptor cache; nothing else about the core changes.
+    output     [31:0]  dbg_IDT_base,
+    output     [19:0]  dbg_IDT_limit,
+    output     [31:0]  dbg_CR0,
     output             dbg_pe,
     output             dbg_vm,
 
@@ -153,6 +159,9 @@
 assign dbg_CS  = CS;
 assign dbg_EIP = EIP;
 assign dbg_CS_base = CS_base;
+assign dbg_IDT_base  = seg_cache[SEG_IDT].base;
+assign dbg_IDT_limit = seg_cache[SEG_IDT].limit;
+assign dbg_CR0       = CR0;
 assign dbg_pe  = pe;
 assign dbg_vm  = vm;
 wire [1:0] cpl = vm ? 2'd3 : !pe ? 2'd0 : CS[1:0];
